# ─── Mobile (EXPO_PUBLIC_* exposes to the client) ─────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_SENTRY_DSN=

# EAS
EAS_PROJECT_ID=

# ─── Server: Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Server: WhatsApp Cloud API (Meta) ────────────────────────────────────────
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ─── Server: AI ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_PROMPT_VERSION=v1

# ─── Server: AI daily caps ────────────────────────────────────────────────────
AI_CAP_TRANSCRIPTION_SECONDS=600
AI_CAP_LLM_TOKENS=50000
AI_CAP_COST_CENTS=200

# ─── Server: Observability ────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
PORT=3000
NODE_ENV=development

# ─── Dev tooling: Trello MCP (gestão de tarefas via Claude Code) ──────────────
# Gere API key + token em https://trello.com/app-key
# BOARD_ID está na URL do board: trello.com/b/<BOARD_ID>/...
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
