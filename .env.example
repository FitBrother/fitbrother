# ─── Dev tooling: Trello MCP (gestão de tarefas via Claude Code) ──────────
# Generate at https://trello.com/app-key
# BOARD_ID is in the URL: trello.com/b/<BOARD_ID>/...
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# ─── Dev tooling: Sentry CLI (upload source maps in EAS Build) ────────────
# Used by @sentry/react-native to upload source maps during build
# Generate at https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
SENTRY_ORG=

# ─── M5.3 — Phone OTP (verificação de telefone p/ social) ─────────────────
# Em dev usa supabase/config.toml [auth.sms.test_otp] (sem custo, número fixo).
# Em staging/prod configure um provider SMS (ex.: Twilio) e seus secrets.
# Prod e dev
