# ─── Mobile: Supabase ─────────────────────────────────────────────────────
# EXPO_PUBLIC_* variables are embedded at bundle time by Expo Metro
# These point to the same Supabase project as the server
# Local dev: use the local anon key from 'supabase start'
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─── Mobile: API server override (optional) ──────────────────────────────
# Only set if you want to override auto-detected LAN IP (from Metro packager)
# See lib/dev-host.ts for auto-detection logic
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.107:3000
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.107:54321

# ─── Mobile: Observability ───────────────────────────────────────────────
# Sentry error tracking DSN for mobile app
# https://sentry.io/
EXPO_PUBLIC_SENTRY_DSN=

# ─── Mobile: EAS ─────────────────────────────────────────────────────────
# Get from https://expo.dev/projects
# Used by EAS Build CLI to identify your project
EAS_PROJECT_ID=
