{
  "expo": {
    "name": "Fitbrother",
    "slug": "fitbrother",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fitbrother",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitbrother.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O Fitbrother usa o microfone para gravar a descrição da sua refeição."
      }
    },
    "android": {
      "package": "com.fitbrother.app",
      "adaptiveIcon": {
        "backgroundColor": "#F0FDFC"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-font", "expo-secure-store", "expo-localization"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "e84a197d-563b-46e1-a40b-1bec6afc244a"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "fitbrother"
  }
}
