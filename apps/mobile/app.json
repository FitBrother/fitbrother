{
  "expo": {
    "name": "Fitbrother",
    "slug": "fitbrother",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fitbrother",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitbrother.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O Fitbrother usa o microfone para gravar a descrição da sua refeição.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fitbrother.app",
      "adaptiveIcon": {
        "backgroundColor": "#F0FDFC"
      }
    },
    "web": {
      "bundler": "metro",
      "lang": "pt-BR",
      "name": "Fitbrother",
      "shortName": "Fitbrother",
      "description": "App de nutrição com IA — registre refeições por texto ou áudio e acompanhe macros em tempo real.",
      "themeColor": "#06D59F",
      "backgroundColor": "#F8FAFC"
    },
    "plugins": ["expo-router", "expo-font", "expo-secure-store", "expo-localization"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "legal": {
        "termsUrl": "https://fitbrother.app/termos",
        "privacyUrl": "https://fitbrother.app/privacidade"
      },
      "eas": {
        "projectId": "fda12d37-23d7-4599-a65f-ed1c2995d60a"
      }
    }
  }
}
