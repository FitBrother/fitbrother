    "@fitbrother/db-types": "*",
    "@fitbrother/shared": "*",
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^8.45.0",
    "@supabase/supabase-js": "^2.47.10",
    "dotenv": "^16.4.7",
    "envalid": "^8.0.0",
    "fastify": "^5.2.0",
    "jszip": "^3.10.1",
    "openai": "^6.39.0",
    "pg-boss": "^10.1.5",
