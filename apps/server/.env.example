# ─── Server: Runtime ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Server: Supabase ─────────────────────────────────────────────────────
# Local: http://127.0.0.1:54321 (Supabase stack via 'supabase start')
# Prod: your-project.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Server: WhatsApp Cloud API (Meta) ────────────────────────────────────
# Get from Meta Business Manager: https://www.facebook.com/business
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Server: AI ───────────────────────────────────────────────────────────
# Choose: 'gemini' or 'openai'
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Version bumped = cache invalidation for all LLM extractions
LLM_PROMPT_VERSION=v1

# ─── Server: AI daily caps ────────────────────────────────────────────────
# Whisper transcription max seconds per day per user
AI_CAP_TRANSCRIPTION_SECONDS=600
# LLM tokens max per day per user
AI_CAP_LLM_TOKENS=50000
# Max cost in cents per day per user
AI_CAP_COST_CENTS=200

# ─── Server: Observability ────────────────────────────────────────────────
# Sentry error tracking: https://sentry.io/
SENTRY_DSN=
