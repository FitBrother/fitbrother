{
  "name": "fitbrother",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run dev --workspace apps/mobile",
    "dev:server": "npm run dev --workspace apps/server",
    "build:server": "npm run build --workspace packages/shared && npm run build --workspace apps/server",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:reset-user": "./scripts/reset-user.sh",
    "db:seed:foods": "tsx supabase/seed/foods-taco.ts",
    "db:types": "supabase gen types typescript --local > packages/db-types/index.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0 && npm run test:legal-copy && npm run lint:legal-copy",
    "test:legal-copy": "tsx --test scripts/legal-copy/scan.test.ts",
    "lint:legal-copy": "tsx scripts/check-legal-copy.ts",
    "format": "prettier --write .",
    "prepare": "husky",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "supabase": "^2.98.2",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "expo": "~54.0.34",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
